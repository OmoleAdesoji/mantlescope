{
  "name": "mantlescope",
  "version": "1.0.0",
  "description": "AI-powered wallet intelligence for Mantle Network — understand any wallet in plain English",
  "private": true,
  "scripts": {
    "compile": "hardhat compile",
    "deploy:testnet": "hardhat run scripts/deploy.js --network mantleTestnet",
    "deploy:mainnet": "hardhat run scripts/deploy.js --network mantleMainnet",
    "verify:testnet": "hardhat verify --network mantleTestnet",
    "frontend": "cd frontend && npx serve ."
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "hardhat": "^2.22.0",
    "dotenv": "^16.4.0"
  }
}
